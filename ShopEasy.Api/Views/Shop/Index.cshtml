@model IEnumerable<ShopEasy.Api.Models.Product>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>ShopEasy</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="container mt-4">
    <h1>ShopEasy Products</h1>
    <a asp-action="Create" class="btn btn-primary mt-2">Add Product</a>

    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td>₹@p.Price.ToString("N2")</td>
                    <td>@p.Stock</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>